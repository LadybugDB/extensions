-DATASET CSV fts-basic

--

-CASE FTSDeletion
-LOAD_DYNAMIC_EXTENSION fts
-STATEMENT CREATE (b:Book {title: 'Alice wonderland', author: 'newton', abstract: 'machine'})
---- ok
-STATEMENT CREATE (b:Book {title: 'Alice w', author: 'newton', abstract: 'not exist'})
---- ok
-STATEMENT CALL CREATE_FTS_INDEX('Book', 'book_index', ['abstract', 'author', 'title'], stemmer := 'porter');
---- ok
-STATEMENT CALL QUERY_FTS_INDEX('Book', 'book_index', 'alice') RETURN node.title,score;
---- 3
Alice wonderland|0.430161
Alice w|0.464036
The Quantum World|0.352879
-STATEMENT MATCH (b:Book) where b.title = 'Alice w' delete b
---- ok
-STATEMENT CALL QUERY_FTS_INDEX('Book', 'book_index', 'a quantum machine') RETURN node.title,score;
---- 3
Alice wonderland|0.549301
Learning Machines|0.599514
The Quantum World|0.931796
-STATEMENT MATCH (b:Book) where b.title = 'Alice wonderland' delete b
---- ok
-STATEMENT CALL QUERY_FTS_INDEX('Book', 'book_index', 'a quantum machine') RETURN node.title,score;
---- 2
Learning Machines|0.827832
The Quantum World|0.857996
-STATEMENT CALL QUERY_FTS_INDEX('Book', 'book_index', 'alice') RETURN node.title,score;
---- 1
The Quantum World|0.634506

-CASE consecutiveDeletions
-LOAD_DYNAMIC_EXTENSION fts
-STATEMENT CREATE NODE TABLE doc (ID UINT64, content STRING, PRIMARY KEY (ID));
---- ok
-STATEMENT COPY doc FROM '${LBUG_ROOT_DIRECTORY}/dataset/ms-passage/vDoc.csv'
---- ok
-STATEMENT CALL CREATE_FTS_INDEX('doc', 'contentIdx', ['content'])
---- ok
-STATEMENT CALL threads=1
---- ok
-STATEMENT match (d:doc) where d.ID = 437 delete d
---- ok
-STATEMENT CALL query_fts_index('doc', 'contentIdx', 'dispossessed meaning') RETURN node.id, score order by score, node.id;
---- 8
109|2.011124
134|1.976951
199|1.865470
202|1.927272
389|1.822145
390|3.018760
429|1.943921
432|1.822145
-STATEMENT match (d:doc) where d.ID >= 390 delete d
---- ok
-STATEMENT CALL query_fts_index('doc', 'contentIdx', 'dispossessed meaning') RETURN node.id, score order by score, node.id;
---- 5
109|2.103948
134|2.068176
199|1.951345
202|2.016027
389|1.906131

-CASE FTSDeletionEmptyDoc
-LOAD_DYNAMIC_EXTENSION fts
-STATEMENT CREATE NODE TABLE doc (ID UINT64, content STRING, PRIMARY KEY (ID));
---- ok
-STATEMENT create (d:doc {ID: 100, content: 'alice is brother of bob'})
---- ok
-STATEMENT create (d:doc {ID: 10, content: 'allow almost'})
---- ok
-STATEMENT CALL CREATE_FTS_INDEX('doc', 'contentIdx', ['content'])
---- ok
-STATEMENT MATCH (d:doc) DELETE d
---- ok

-CASE FTSDeleteTokenContainingTokenizerName
-LOAD_DYNAMIC_EXTENSION fts
-STATEMENT CREATE NODE TABLE A(id INT64, name STRING, PRIMARY KEY(id));
---- ok
-STATEMENT CREATE (a:A {id: 1, name: 'simplex'});
---- ok
-STATEMENT CALL CREATE_FTS_INDEX('A', 'a_idx', ['name'], stemmer := 'none');
---- ok
-STATEMENT CALL QUERY_FTS_INDEX('A', 'a_idx', 'simplex') RETURN node.id;
---- 1
1
-STATEMENT MATCH (a:A) WHERE a.id = 1 DELETE a;
---- ok
-STATEMENT MATCH (a:A) RETURN count(a);
---- 1
0
-CASE FTSDeleteDefaultStopwordWithStemmerNone
-LOAD_DYNAMIC_EXTENSION fts
-STATEMENT CREATE NODE TABLE DefinitionNode(id INT64, name STRING, path STRING, PRIMARY KEY(id));
---- ok
-STATEMENT CREATE (:DefinitionNode {id: 1, name: 'tool.go', path: 'tool.go'});
---- ok
-STATEMENT CALL CREATE_FTS_INDEX('DefinitionNode', 'def_search_idx_0', ['name'], stemmer := 'none');
---- ok
# Create-time indexing removes default stopword token 'go', keeping only 'tool'.
-STATEMENT CALL QUERY_FTS_INDEX('DefinitionNode', 'def_search_idx_0', 'tool') RETURN node.id;
---- 1
1
-STATEMENT CALL QUERY_FTS_INDEX('DefinitionNode', 'def_search_idx_0', 'go') RETURN node.id;
---- 0
# Delete maintenance must reconstruct the same stopword-filtered terms as create.
-STATEMENT UNWIND ['tool.go'] AS path MATCH (n:DefinitionNode) WHERE n.path = path DETACH DELETE n;
---- ok
-STATEMENT MATCH (n:DefinitionNode) RETURN count(n);
---- 1
0


-CASE FTSMixedCreateInsertStopwordDeleteWithStemmerNone
-LOAD_DYNAMIC_EXTENSION fts
-STATEMENT CREATE NODE TABLE DefinitionNode(id INT64, name STRING, path STRING, PRIMARY KEY(id));
---- ok
-STATEMENT CREATE (:DefinitionNode {id: 1, name: 'tool.go', path: 'tool.go'});
---- ok
-STATEMENT CALL CREATE_FTS_INDEX('DefinitionNode', 'def_search_idx_0', ['name'], stemmer := 'none');
---- ok
# Create-time row does not index stopword token 'go'.
-STATEMENT CALL QUERY_FTS_INDEX('DefinitionNode', 'def_search_idx_0', 'go') RETURN node.id;
---- 0
-STATEMENT CREATE (:DefinitionNode {id: 2, name: 'server.go', path: 'server.go'});
---- ok
# Runtime insert must apply the same stopword filtering as index creation.
-STATEMENT CALL QUERY_FTS_INDEX('DefinitionNode', 'def_search_idx_0', 'go') RETURN node.id ORDER BY node.id;
---- 0
# Deleting a create-time row must not affect the surviving runtime-inserted row.
-STATEMENT UNWIND ['tool.go'] AS path MATCH (n:DefinitionNode) WHERE n.path = path DETACH DELETE n;
---- ok
-STATEMENT MATCH (n:DefinitionNode) RETURN n.id, n.name ORDER BY n.id;
---- 1
2|server.go
-STATEMENT CALL QUERY_FTS_INDEX('DefinitionNode', 'def_search_idx_0', 'server') RETURN node.id;
---- 1
2
# The configured stopword remains absent after deletion.
-STATEMENT CALL QUERY_FTS_INDEX('DefinitionNode', 'def_search_idx_0', 'go') RETURN node.id;
---- 0
