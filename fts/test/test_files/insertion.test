Storm Weaver|0.934315
The Mind Machine|0.756869
-STATEMENT ALTER TABLE Book DROP abstract
---- error
Binder exception: Cannot drop property abstract in table Book because it is used in one or more indexes. Please remove the associated indexes before attempting to drop this property.

-CASE DeleteAndReCopy
-LOAD_DYNAMIC_EXTENSION fts
-STATEMENT CALL CREATE_FTS_INDEX('Book', 'book_index', ['abstract', 'author', 'title'], stemmer := 'porter');
---- ok
-STATEMENT MATCH (b:Book) DELETE b;
---- ok
-STATEMENT CHECKPOINT;
---- ok
-STATEMENT CREATE (b:Book {title: 'Alice wonderland', author: 'newton', abstract: 'machine'})
---- ok
-STATEMENT COPY Book FROM '${LBUG_ROOT_DIRECTORY}/dataset/fts-basic/Book.csv';
---- ok
-STATEMENT CALL QUERY_FTS_INDEX('Book', 'book_index', 'a quantum machine') RETURN node.title, score;
---- 3
Alice wonderland|0.549301
Learning Machines|0.599514
The Quantum World|0.931796

-CASE FTSInsertDefaultStopwordWithStemmerNone
-LOAD_DYNAMIC_EXTENSION fts
-STATEMENT CREATE NODE TABLE doc (ID INT64, content STRING, PRIMARY KEY(ID));
---- ok
-STATEMENT CALL CREATE_FTS_INDEX('doc', 'contentIdx', ['content'], stemmer := 'none');
---- ok
-STATEMENT CREATE (:doc {ID: 1, content: 'tool.go'});
---- ok
-STATEMENT CALL QUERY_FTS_INDEX('doc', 'contentIdx', 'tool') RETURN node.ID;
---- 1
1
-STATEMENT CALL QUERY_FTS_INDEX('doc', 'contentIdx', 'go') RETURN node.ID;
---- 0

-CASE FTSInsertStopwordOnlyBatch
-SKIP_IN_MEM
-LOAD_DYNAMIC_EXTENSION fts
-STATEMENT CREATE NODE TABLE doc (ID INT64, content STRING, PRIMARY KEY(ID));
---- ok
-STATEMENT CALL CREATE_FTS_INDEX('doc', 'contentIdx', ['content'], stemmer := 'none');
---- ok
-STATEMENT COPY doc FROM (RETURN 1 AS ID, 'go' AS content UNION ALL RETURN 2 AS ID, 'tool' AS content);
---- ok
-STATEMENT CALL QUERY_FTS_INDEX('doc', 'contentIdx', 'tool') RETURN node.ID, score;
---- 1
2|0.124939
-STATEMENT MATCH (d:doc) WHERE d.ID = 1 DELETE d;
---- ok
-STATEMENT CALL QUERY_FTS_INDEX('doc', 'contentIdx', 'tool') RETURN node.ID, score;
---- 1
2|0.124939
-STATEMENT MATCH (d:doc) WHERE d.ID = 2 DELETE d;
---- ok
-STATEMENT CALL QUERY_FTS_INDEX('doc', 'contentIdx', 'tool') RETURN node.ID;
---- 0


-CASE FTSInsertStopwordOnlyUnwind
-SKIP_IN_MEM
-LOAD_DYNAMIC_EXTENSION fts
-STATEMENT CREATE NODE TABLE doc (ID INT64, content STRING, PRIMARY KEY(ID));
---- ok
-STATEMENT CALL CREATE_FTS_INDEX('doc', 'contentIdx', ['content'], stemmer := 'none');
---- ok
-STATEMENT UNWIND [{id: 1, content: 'go'}, {id: 2, content: 'tool'}] AS row CREATE (:doc {ID: row.id, content: row.content});
---- ok
-STATEMENT CALL QUERY_FTS_INDEX('doc', 'contentIdx', 'tool') RETURN node.ID, score;
---- 1
2|0.124939
-STATEMENT MATCH (d:doc) WHERE d.ID = 1 DELETE d;
---- ok
-STATEMENT CALL QUERY_FTS_INDEX('doc', 'contentIdx', 'tool') RETURN node.ID, score;
---- 1
2|0.124939