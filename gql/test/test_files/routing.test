-DATASET CSV empty
-BUFFER_POOL_SIZE 1024000000

--

# Statement routing — GQL catalog/session/transaction commands mapped to
# native LadybugDB Cypher statements.

-CASE DropGraphRouting

-STATEMENT load extension "${LBUG_ROOT_DIRECTORY}/extension/gql/build/libgql.lbug_extension"
---- ok

-STATEMENT CALL GQL("CREATE GRAPH temp1 ANY")
---- ok

-STATEMENT CALL GQL("DROP GRAPH temp1")
---- ok

-STATEMENT CALL SHOW_GRAPHS() RETURN *
---- 0


-CASE DropGraphIfExistsRouting

-STATEMENT load extension "${LBUG_ROOT_DIRECTORY}/extension/gql/build/libgql.lbug_extension"
---- ok

-STATEMENT CALL GQL("DROP GRAPH IF EXISTS nonexist")
---- ok


-CASE SessionSetGraphRouting

-STATEMENT load extension "${LBUG_ROOT_DIRECTORY}/extension/gql/build/libgql.lbug_extension"
---- ok

-STATEMENT CALL GQL("CREATE GRAPH g1 ANY")
---- ok

-STATEMENT CALL GQL("SESSION SET GRAPH g1")
---- ok


-CASE TransactionRouting

-STATEMENT load extension "${LBUG_ROOT_DIRECTORY}/extension/gql/build/libgql.lbug_extension"
---- ok

-STATEMENT CALL GQL("START TRANSACTION")
---- ok

-STATEMENT CALL GQL("COMMIT")
---- ok

-STATEMENT CALL GQL("START TRANSACTION")
---- ok

-STATEMENT CALL GQL("ROLLBACK")
---- ok

-STATEMENT CALL GQL("START TRANSACTION READ ONLY")
---- ok

-STATEMENT CALL GQL("COMMIT")
---- ok
