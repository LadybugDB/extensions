-DATASET CSV empty
-BUFFER_POOL_SIZE 1024000000

--

# Phase 3 — path patterns: quantified edges / QPPI, path modes (WALK/TRAIL/
# ACYCLIC), search prefixes (ANY/ALL SHORTEST) and GQL edge spellings.
# Dual-run parity: each GQL case is followed by the equivalent Cypher asserting
# the same expected result.

-CASE QuantifiedEdgeIntervalParity

-STATEMENT load extension "${LBUG_ROOT_DIRECTORY}/extension/gql/build/libgql.lbug_extension"
---- ok

-STATEMENT CREATE NODE TABLE Person(v INT64, PRIMARY KEY(v))
---- ok

-STATEMENT CREATE REL TABLE KNOWS(FROM Person TO Person)
---- ok

-STATEMENT CREATE (:Person {v:1})-[:KNOWS]->(:Person {v:2})-[:KNOWS]->(:Person {v:3})-[:KNOWS]->(:Person {v:4})
---- ok

-CHECK_ORDER
-STATEMENT CALL GQL("MATCH (a:Person)-[e:KNOWS]->{2,3}(b:Person) RETURN a.v AS a, b.v AS b ORDER BY a.v, b.v")
---- 3
1|3
1|4
2|4

-CHECK_ORDER
-STATEMENT MATCH (a:Person)-[e:KNOWS*2..3]->(b:Person) RETURN a.v AS a, b.v AS b ORDER BY a.v, b.v
---- 3
1|3
1|4
2|4


