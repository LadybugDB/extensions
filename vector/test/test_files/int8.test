-DATASET CSV empty
-BUFFER_POOL_SIZE 134217728

--

-CASE DirectInt8CosineDistances
-LOAD_DYNAMIC_EXTENSION vector
-STATEMENT CREATE NODE TABLE embeddings (id INT64, vec INT8[4], PRIMARY KEY (id));
---- ok
-STATEMENT CREATE (:embeddings {id: 0, vec: [1, 0, 0, 0]});
---- ok
-STATEMENT CREATE (:embeddings {id: 1, vec: [0, 1, 0, 0]});
---- ok
-STATEMENT CREATE (:embeddings {id: 2, vec: [-1, 0, 0, 0]});
---- ok
-STATEMENT CREATE (:embeddings {id: 3, vec: [1, 0, 0, 0]});
---- ok
-STATEMENT CREATE (:embeddings {id: 4, vec: [0, 0, 0, 0]});
---- ok
-STATEMENT CALL CREATE_VECTOR_INDEX('embeddings', 'i8_cos', 'vec', metric := 'cosine', quantization := 'none');
---- ok
# Against [1,0,0,0]: identical->0, orthogonal->1, opposite->2, zero->1
-STATEMENT CALL QUERY_VECTOR_INDEX('embeddings', 'i8_cos', CAST([1, 0, 0, 0], 'INT8[4]'), 5, search_type := 'naive') RETURN node.id, distance ORDER BY distance, node.id;
-CHECK_ORDER
---- 5
0|0.000000
3|0.000000
1|1.000000
4|1.000000
2|2.000000
# Zero vs zero -> 0; zero vs non-zero -> 1 (SimSIMD policy)
-STATEMENT CALL QUERY_VECTOR_INDEX('embeddings', 'i8_cos', CAST([0, 0, 0, 0], 'INT8[4]'), 5, search_type := 'naive') RETURN node.id, distance ORDER BY distance, node.id;
-CHECK_ORDER
---- 5
4|0.000000
0|1.000000
1|1.000000
2|1.000000
3|1.000000
# HNSW search returns the same nearest neighbors as naive for exact matches
-STATEMENT CALL QUERY_VECTOR_INDEX('embeddings', 'i8_cos', CAST([1, 0, 0, 0], 'INT8[4]'), 2, efs := 50) RETURN node.id, distance ORDER BY distance, node.id;
-CHECK_ORDER
---- 2
0|0.000000
3|0.000000
# No internal _QEMB table for the direct INT8 path
-STATEMENT CALL SHOW_TABLES() WHERE name CONTAINS 'QEMB' RETURN count(*);
---- 1
0
# Cache-on HNSW search remains usable after checkpoint/reload
-RELOADDB
-LOAD_DYNAMIC_EXTENSION vector
-STATEMENT CALL QUERY_VECTOR_INDEX('embeddings', 'i8_cos', CAST([1, 0, 0, 0], 'INT8[4]'), 2, efs := 50) RETURN node.id, distance ORDER BY distance, node.id;
-CHECK_ORDER
---- 2
0|0.000000
3|0.000000

